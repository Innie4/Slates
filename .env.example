# Local development. npm run dev and npm start load the ignored .env file.
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
# Set a PostgreSQL connection URL to use the pg store; blank uses local SQLite.
DATABASE_URL=
DATABASE_PATH=data/slate.sqlite
STATIC_DIRECTORY=dist
# On Render, set HOST=0.0.0.0 and DATABASE_URL in the service environment.
# Set APP_ORIGIN to the public HTTPS origin, or omit it to use RENDER_EXTERNAL_URL.
# Render supplies PORT. Never deploy SQLite on a free ephemeral service.
# Set only to the exact address of a trusted gateway that overwrites X-Real-IP.
TRUSTED_PROXY_IPS=
# Server-only Google web client. Its redirect must exactly match APP_ORIGIN.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Optional Apple configuration requires Apple's developer setup. Leave blank on free staging.
AUTH_APPLE_CLIENT_ID=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=
