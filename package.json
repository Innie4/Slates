{
  "name": "slate-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "node --test tests/server/*.test.ts && node scripts/check-routes.mjs && node scripts/check-copy.mjs",
    "test:browser": "node tests/browser/journey.mjs",
    "test:calendar": "node tests/date-picker.browser.mjs",
    "test:sessions": "node tests/browser/session-races.mjs",
    "test:production": "node tests/browser/production.mjs",
    "test:public": "node scripts/ui-public-checks.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "lucide-react": "^1.52.0",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
